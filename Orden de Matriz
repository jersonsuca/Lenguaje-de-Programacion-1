#include <iostream>
using namespace std;
int main()
{
    int n;
    cout << "Ingrese el orden N de la matriz: ";
    cin >> n;
    int matriz[50][50];
    
    cout << "INGRESE DATOS DE LA MATRIZ" << endl;
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            cout << "Elemento [" << i << "][" << j << "] : ";
            cin >> matriz[i][j];}
    }
    
	cout << "MATRIZ INGRESADA" << endl;
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            cout << matriz[i][j] << "\t";}
        cout << endl; }

    return 0;
}
